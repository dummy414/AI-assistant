# 비밀 키 — 절대 커밋하지 말 것
.env

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/
env/

# 생성물
data/*.png
data/*.csv
data/*.json
models/*.npz

# OS / 에디터
.DS_Store
.idea/
*.log

# Netlify 로컬 연결 상태 (사이트 ID 등, 기기별)
.netlify/

# 화면 확인 도구 (node tools/screenshot.mjs)
node_modules/
package-lock.json
tools/shots/

# 매일 새로 만들어지는 데이터 — 진짜 저장소는 배포된 사이트다.
# (Netlify는 깃허브를 보지 않고 로컬 dist 폴더를 직접 올린다)
card_news/dist/*.json
card_news/data.json
card_news/quality.json
card_news/radar.json
