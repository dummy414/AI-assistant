# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (cp .env.example .env)
# .env 는 .gitignore에 있어 GitHub에 올라가지 않습니다.
#
# 사용법: 터미널에서 아래처럼 환경변수로 불러오거나,
#   export $(cat .env | xargs)
# python-dotenv를 쓰면 자동으로 읽을 수도 있습니다.

# 데이터 소스: synthetic (기본) / alpaca / massive
DATA_SOURCE=synthetic

# 거래 종목
SYMBOL=SPY

# Alpaca 페이퍼 트레이딩 키 (https://alpaca.markets 에서 발급)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Massive API 키 (https://massive.com 에서 발급)
MASSIVE_API_KEY=
